# Supabase project configuration (public/publishable values only)
SUPABASE_PROJECT_ID=your-project-id
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PROJECT_ID=your-project-id
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Configure server-only secrets in Lovable Cloud / deployment environment.
# Never place SUPABASE_SERVICE_ROLE_KEY or payment-provider secrets in VITE_* variables.
